# Required
DISCORD_TOKEN=your-bot-token-here

# Your server ID(s), comma-separated. Commands appear instantly there.
# The bot must already be IN this server. Leave empty to sync globally instead.
GUILD_ID=

# Comma-separated role IDs allowed to use finance/invoice commands (Admins always can)
STAFF_ROLE_IDS=

# Optional: general log channel (also used for overdue invoices)
LOG_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Tickets
# ---------------------------------------------------------------------------
# Category where ticket channels are created (leave empty for server root)
TICKET_CATEGORY_ID=
# Optional: closed tickets are moved here and made read-only
TICKET_CLOSED_CATEGORY_ID=
# Roles that can see/manage every ticket. Falls back to STAFF_ROLE_IDS.
TICKET_STAFF_ROLE_IDS=
# Transcripts, close/reopen logs and the daily stale-ticket digest go here
TICKET_LOG_CHANNEL_ID=
TICKET_PREFIX=ticket
TICKET_CLOSED_PREFIX=closed
# Tickets with no messages for this many days appear in /ticket dashboard
TICKET_STALE_DAYS=3
# Max open tickets per client (0 = unlimited, staff are not limited)
TICKET_MAX_OPEN_PER_USER=3
TICKET_TRANSCRIPT_DIR=data/transcripts

# ---------------------------------------------------------------------------
# Sales pipeline (buying enquiries)
# ---------------------------------------------------------------------------
# Follow-up reminders and pipeline alerts. Falls back to TICKET_LOG_CHANNEL_ID / LOG_CHANNEL_ID.
SALES_CHANNEL_ID=
FOLLOWUP_CHECK_MINUTES=30
SALES_LOOKAHEAD_DAYS=7

# ---------------------------------------------------------------------------
# Transaction details feed
# ---------------------------------------------------------------------------
# Comma-separated channel IDs that receive "Payment Received-35" style posts.
# Falls back to LOG_CHANNEL_ID when left empty.
TRANSACTION_CHANNEL_IDS=
SHOW_GROSS_SALES=true

# ---------------------------------------------------------------------------
# Business details printed on PDFs
# ---------------------------------------------------------------------------
BUSINESS_NAME=My Hosting Company
BUSINESS_TAGLINE=Reliable hosting. Powerful solutions.
BUSINESS_EMAIL=support@example.com
BUSINESS_PHONE=+91 00000 00000
BUSINESS_ADDRESS=City, State
BUSINESS_TAX_ID=
PAYMENT_INSTRUCTIONS=Pay via UPI: yourname@upi
REFUND_POLICY=Refunds are only available within 24 hours after the purchase has been made.
TERMS=Payment is due by the due date shown|Services may be suspended for overdue invoices
BRAND_COLOR=#6D28D9
# Logo: replace assets/logo.png (a transparent PNG works best)
LOGO_PATH=assets/logo.png

# Money (INR shows ₹ with Indian digit grouping)
CURRENCY=INR
TIMEZONE=Asia/Kolkata
INVOICE_PREFIX=INV
DB_PATH=data/bot.db
# Optional: put a signature image at assets/signature.png to print it above 'Authorized Signatory'
